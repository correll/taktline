# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (SQLAlchemy async / asyncpg). Local Homebrew Postgres uses trust
# auth (your OS user, no password). Hosted: postgresql+asyncpg://user:pass@host/db
# (e.g. a Neon connection string — keep the +asyncpg driver).
DATABASE_URL=postgresql+asyncpg://localhost:5432/taktline

# ─── Dev mode ───────────────────────────────────────────────────────────────
# Returns verification/invite links in API responses and enables
# POST /auth/dev/bootstrap (used by seed_demo.py and tests). MUST be 0/unset in
# production.
TAKTLINE_DEV=1

# ─── Secrets & cookies ──────────────────────────────────────────────────────
SECRET_KEY=dev-insecure-secret-change-in-production   # long random value in prod

# Cross-origin deploy (SPA and API on different hosts): COOKIE_SAMESITE=none +
# COOKIE_SECURE=1. Same-origin/local: leave as below.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com   # only if sharing cookies across subdomains

# Browser origins allowed by CORS (comma-separated). Never "*" with credentials.
CORS_ORIGINS=http://localhost:3000

# Links embedded in outbound email (verification, invitations, reset).
FRONTEND_BASE_URL=http://localhost:3000

# ─── Email ──────────────────────────────────────────────────────────────────
# Precedence: SENDGRID_API_KEY → SMTP_* → console (dev, prints the link).
#
# Resend (the documented default — see DEPLOY.md). The API key is the
# SMTP *password*; the username is the literal string "resend".
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587            # STARTTLS. Resend also offers 465/2465 (implicit
#                          # TLS) and 2587 — the port picks the TLS mode.
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Taktline <no-reply@yourdomain.com>
#
# Any other SMTP provider works the same way. SENDGRID_API_KEY is only a
# shortcut that fills in smtp.sendgrid.net for you — leave it UNSET unless you
# actually use SendGrid, because it takes precedence over the SMTP_* values
# above and would send your other provider's key to the wrong server.
# SENDGRID_API_KEY=SG.xxxxxxxx

# ─── Uploads ────────────────────────────────────────────────────────────────
# MAX_UPLOAD_BYTES=10485760   # 10 MB (floor-plan images)

# ─── Single-service hosting (optional) ──────────────────────────────────────
# Serve the built SPA from this backend so API + app share one origin (simplest
# and most secure). Point at the built frontend directory.
# FRONTEND_DIST=/app/frontend/dist

# ─── Backfill migration default admin ───────────────────────────────────────
# Used ONLY by the migration when attributing pre-existing (pre-multi-tenancy)
# data to a default company.
DEFAULT_ADMIN_EMAIL=admin@taktline.dev
DEFAULT_ADMIN_PASSWORD=change-me-admin-0000

# ── Platform staff ────────────────────────────────────────────────────────────
# Comma-separated emails with platform-OWNER powers (customer-service dashboard,
# impersonation, deletes, granting the 'support' role). Env-only by design.
PLATFORM_OWNER_EMAILS=
