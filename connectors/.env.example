# ─────────────────────────────────────────────────────────────────────────
# Shared — every connector needs these
# ─────────────────────────────────────────────────────────────────────────
TAKTLINE_URL=http://localhost:8000
# Create under Settings → Integrations → API keys (scope: orders). Shown once.
TAKTLINE_API_KEY=tk_xxxxxxxxxxxxxxxxxxxxxxxx

# ERP product ref → Taktline lot-template id. Copy the template ids from
# Settings → Integrations → Product ids. JSON object.
PRODUCT_MAPPING={"BIKE-001":"<taktline-template-id>","BIKE-002":"<taktline-template-id>"}

POLL_INTERVAL=30
# Optional: override which ERP order states get pulled (comma-separated).
# ORDER_STATES=confirmed,progress

# ─────────────────────────────────────────────────────────────────────────
# Odoo  (python -m taktline_connect odoo)
# ─────────────────────────────────────────────────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin           # or ODOO_API_KEY=...

# ─────────────────────────────────────────────────────────────────────────
# NetSuite  (python -m taktline_connect netsuite)  — token-based auth
# ─────────────────────────────────────────────────────────────────────────
NETSUITE_ACCOUNT=1234567           # or 1234567_SB1 for a sandbox
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
# NetSuite WO statuses to pull (display text). Default: "Work Order:Pending Build"
# ORDER_STATES=Work Order:Pending Build,Work Order:In Process

# ─────────────────────────────────────────────────────────────────────────
# Shopify  (python -m taktline_connect shopify)  — Admin REST + access token
#   paid+open line items → release · cancelled/refunded → cancel
# ─────────────────────────────────────────────────────────────────────────
SHOPIFY_SHOP=my-store.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01
# PRODUCT_MAPPING keys are line-item SKUs.
# Opt-in: on Taktline completion, fulfil the Shopify order (default off).
# SHOPIFY_FULFILL_ON_COMPLETE=1

# ─────────────────────────────────────────────────────────────────────────
# WooCommerce  (python -m taktline_connect woocommerce)  — wc/v3, key+secret
# ─────────────────────────────────────────────────────────────────────────
WOO_URL=https://store.example.com
WOO_CONSUMER_KEY=ck_xxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# QuickBooks Online  (python -m taktline_connect quickbooks)  — OAuth2 refresh
#   Accepted Estimates (QBO_DOC) → releases. PRODUCT_MAPPING keys = ItemRef names.
# ─────────────────────────────────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENV=production          # or: sandbox
# QBO_DOC=Estimate          # sales doc that signals "make this"

# ─────────────────────────────────────────────────────────────────────────
# Xero  (python -m taktline_connect xero)  — OAuth2 refresh
#   Accepted Quotes → releases. PRODUCT_MAPPING keys = line-item Item Codes.
# ─────────────────────────────────────────────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

# ─────────────────────────────────────────────────────────────────────────
# ShipStation  (python -m taktline_connect shipstation)  — HTTP Basic
#   awaiting_shipment items → releases · Taktline completion → mark shipped.
# ─────────────────────────────────────────────────────────────────────────
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Generic REST  (python -m taktline_connect generic)  — poll any JSON endpoint
#   The thin on-ramp for Zoho Inventory, Cin7/DEAR, MRPeasy, Acumatica,
#   Business Central, or a custom app.
# ─────────────────────────────────────────────────────────────────────────
GENERIC_ORDERS_URL=https://api.example.com/orders
GENERIC_AUTH_HEADER=Bearer xxxxxxxx
GENERIC_FIELDS={"id":"orderNo","product_ref":"sku","qty":"quantity","state":"status"}
